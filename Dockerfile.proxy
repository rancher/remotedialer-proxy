FROM registry.suse.com/rancher/appco-go:1.27.4 AS builder
WORKDIR /app

COPY . .
RUN go mod download

RUN CGO_ENABLED=0 go build -o /app/bin/proxy ./cmd/proxy

FROM registry.suse.com/bci/bci-nano:16.0@sha256:bd320c19cdd028e8627847c920561b358813555f2f050a8d7365b08a14feb7e0
COPY --from=builder /app/bin/proxy /usr/bin/proxy
USER 1000
CMD ["/usr/bin/proxy"]
