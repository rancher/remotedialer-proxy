FROM registry.rancher.com/rancher/appco-go:1.26.10@sha256:9cfad6bf7b959068b56127614ab68391b31ebc509b347178ce7d9cdcca884eba AS builder
WORKDIR /app

COPY . .
RUN go mod download

RUN CGO_ENABLED=0 go build -o /app/bin/proxy ./cmd/proxy

FROM registry.suse.com/bci/bci-nano:15.7
COPY --from=builder /app/bin/proxy /usr/bin/proxy
USER 1000
CMD ["/usr/bin/proxy"]
